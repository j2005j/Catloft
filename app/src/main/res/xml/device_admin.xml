<?xml version="1.0" encoding="utf-8"?>
<!-- The whole policy set Catloft asks for: force-lock, so double-tap can turn the screen
     off. Nothing else is requested and nothing else is granted. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>

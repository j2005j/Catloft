<?xml version="1.0" encoding="utf-8"?>
<!-- Swipe down on the home screen opens the notification shade (Nova's mechanism).
     Deliberately minimal: no window content is read and no event matters to Catloft — the
     service exists only so GLOBAL_ACTION_NOTIFICATIONS is allowed.
     NOTE: no android:accessibilityServiceType here. That attribute is not exposed in the
     compile SDK's public resource table (aapt: "attribute android:accessibilityServiceType
     not found"), and it gates nothing we need — global actions are not service-type gated. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/a11y_description" />
